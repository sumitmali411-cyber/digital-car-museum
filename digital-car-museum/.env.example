# Copy to .env (git-ignored) and fill in. Never commit real values.

# MySQL
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SPRING_DATASOURCE_PASSWORD=
MYSQL_URL=jdbc:mysql://localhost:3306/autovault?createDatabaseIfNotExist=true&useSSL=true&requireSSL=false&allowPublicKeyRetrieval=true

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=
KC_DB_PASSWORD=
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/autovault
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/autovault/protocol/openid-connect/certs

# phpMyAdmin
PMA_PASSWORD=

# Origin allowed to call the API
FRONTEND_ORIGIN=http://localhost:4200

# Swagger UI / api-docs are permitAll. Set false on any deployed environment.
SWAGGER_ENABLED=true
